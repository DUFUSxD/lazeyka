{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.8.1",
  "description": "__MSG_extDesc__",
  "default_locale": "ru",
  "icons": {
    "16": "icons/on16.png",
    "32": "icons/on32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "proxy",
    "privacy",
    "storage",
    "alarms",
    "activeTab",
    "notifications",
    "favicon",
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://127.0.0.1:19090/*",
    "https://speed.cloudflare.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/off16.png",
      "32": "icons/off32.png"
    }
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_toggle__"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
